# Variables usadas por docker-compose.yml (entorno de desarrollo con Docker).
# Copiar a `.env` en la raíz del repo y ajustar si hace falta:
#
#   cp .env.example .env
#
# Este archivo NO reemplaza apps/api/.env ni apps/web/.env: esos siguen
# usándose para el flujo manual (sin Docker) descripto en el README.
# docker-compose.yml ya trae valores por defecto razonables para desarrollo,
# así que copiar este archivo es opcional salvo que quieras cambiar algo
# (por ejemplo, la contraseña de la usuaria admin sembrada).

# --- Postgres (servicio "db") ---
POSTGRES_USER=cafeconluna
POSTGRES_PASSWORD=cafeconluna
POSTGRES_DB=cafeconluna
POSTGRES_PORT=5432

# --- API (servicio "api") ---
SESSION_COOKIE_NAME=cafeconluna_session
WEB_ORIGIN=http://localhost:5173

# Usadas por prisma/seed.ts para crear la usuaria admin inicial.
# Cambiar ADMIN_PASSWORD antes de compartir el entorno con alguien más.
ADMIN_EMAIL=admin@cafeconluna.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- Web (servicio "web") ---
# URL de la API tal como la ve el navegador (no la red interna de Docker).
VITE_API_URL=http://localhost:4000/graphql
