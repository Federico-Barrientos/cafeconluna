# Imagen de DESARROLLO para apps/api. No usar en producción:
# instala devDependencies, corre tsx watch y depende de un bind mount
# con el código fuente (ver docker-compose.yml en la raíz del repo).
#
# Se usa node:22-bookworm-slim (glibc) en vez de alpine porque sharp y los
# engines de Prisma resuelven binarios nativos con más fricción en musl.
# Node 22 porque el pnpm fijado en package.json (packageManager) lo requiere.
FROM node:22-bookworm-slim

# Prisma necesita openssl para su motor de consultas en runtime.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable

WORKDIR /app

# Copiamos primero los manifests del workspace completo (el lockfile es
# único para todo el monorepo) para aprovechar la cache de capas.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json

RUN pnpm install --frozen-lockfile

# Copiamos el resto del código para que la imagen sea usable standalone
# (docker compose la pisa con un bind mount, pero así el Dockerfile
# también sirve para un `docker build` suelto).
COPY . .

EXPOSE 4000

CMD ["pnpm", "run", "dev:api"]
