# Variables de entorno para PRODUCCIÓN (Railway), servicio "api".
# No se usa como archivo real (Railway no lee .env commiteados): esto es
# documentación de qué cargar a mano en Settings → Variables del servicio
# en el dashboard de Railway. Para desarrollo local seguí usando
# apps/api/.env / apps/api/.env.example.
#
# Nada de esto debe commitearse con valores reales. Los "changeme"/URLs de
# ejemplo son placeholders.

# La genera Railway automáticamente al agregar el plugin de Postgres al
# proyecto (botón "New" → "Database" → "PostgreSQL"). Railway expone la
# variable ${{Postgres.DATABASE_URL}} para referenciarla desde el servicio
# "api" sin copiar el valor a mano (Settings → Variables → "New Variable" →
# referenciar la variable del plugin de Postgres).
DATABASE_URL="postgresql://usuario:password@host:puerto/db?schema=public"

# Nombre de la cookie de sesión. Podés dejar el mismo valor que en
# desarrollo, no es sensible.
SESSION_COOKIE_NAME="cafeconluna_session"

# URL PÚBLICA del sitio en Cloudflare Pages (sin barra final), tal como la
# ve el navegador. Se usa para el header CORS (Access-Control-Allow-Origin)
# y determina qué origen puede mandar la cookie de sesión.
# Ejemplo con dominio *.pages.dev por defecto, o el dominio custom si el
# cliente conecta uno propio.
WEB_ORIGIN="https://cafeconluna.pages.dev"

# Marca el entorno como producción: activa `secure: true` y
# `sameSite: "none"` en la cookie de sesión (necesario porque api.railway.app
# y cafeconluna.pages.dev son dominios distintos = cookie cross-site), y
# desactiva mensajes/comportamiento de desarrollo.
NODE_ENV="production"

# Path de montaje del volumen persistente que se crea en Railway (paso a
# paso en la guía de deploy). Tiene que ser una ruta ABSOLUTA dentro del
# contenedor, no relativa, para que no dependa del cwd del proceso.
UPLOADS_DIR="/data/uploads"

# Railway define PORT automáticamente y lo inyecta al contenedor; no hace
# falta setearlo a mano salvo que Railway pida un valor específico en algún
# momento. Se deja documentado por las dudas.
# PORT=4000

# Credenciales de la usuaria admin sembrada por prisma/seed.ts al arrancar
# el contenedor (upsert idempotente por "username": no se duplica ni falla
# en restarts). IMPORTANTE: generar una contraseña NUEVA acá, no reusar
# "changeme"/"pochilulina" ni ninguna otra password usada en desarrollo.
ADMIN_EMAIL="admin@cafeconluna.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="generar-una-password-fuerte-nueva-aca"
