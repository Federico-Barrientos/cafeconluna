# Entorno de DESARROLLO local (flujo manual sin Docker). Para las variables
# que hay que cargar en el dashboard de Railway al deployar a producción,
# ver apps/api/.env.production.example.

DATABASE_URL="postgresql://cafeconluna:cafeconluna@localhost:5432/cafeconluna?schema=public"

# Nombre de la cookie de sesión
SESSION_COOKIE_NAME="cafeconluna_session"

# Carpeta local (volumen) donde se guardan las variantes de las fotos
UPLOADS_DIR="./uploads"

PORT=4000

# Origen del frontend, para CORS y para marcar la cookie como secure solo en producción
WEB_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Usadas por prisma/seed.ts para crear la usuaria admin inicial
ADMIN_EMAIL="admin@cafeconluna.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme"
