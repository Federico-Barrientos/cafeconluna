# Entorno de DESARROLLO local (web corriendo aparte en :5173 contra la api
# en :4000). Vite "hornea" VITE_API_URL en el bundle en tiempo de BUILD (no
# es una variable de runtime).
#
# En producción, apps/api/Dockerfile compila este mismo front y lo sirve
# desde el mismo proceso/origen que la API (ver apps/api/Dockerfile y
# apps/api/.env.production.example), así que ahí VITE_API_URL default a
# "/graphql" (ruta relativa) y no hace falta setear nada.
VITE_API_URL="http://localhost:4000/graphql"
